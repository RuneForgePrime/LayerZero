<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>    
    <!-- NuGet Metadata -->
    <AssemblyName>LayerZero.Tools.Web</AssemblyName>
    <PackageId>LayerZero.Tools.Web</PackageId>
    <Version>1.3.0</Version>
    <Authors>RuneForgePrime</Authors>
    <Company>LayerZero</Company>
    <Description>Convention-based dynamic JS/CSS bundling and injection system for ASP.NET Core.</Description>
    <RepositoryUrl>https://github.com/RuneForgePrime/LayerZero</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RuneForgePrime/LayerZero</PackageProjectUrl>
    <PackageTags>bundle;aspnetcore;razor;taghelpers</PackageTags>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>

  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Icon\**" />
    <EmbeddedResource Remove="Icon\**" />
    <None Remove="Icon\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUglify" Version="1.21.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LayerZero.Tools\LayerZero.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="CHANGELOG.md" Pack="true" PackagePath="">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
