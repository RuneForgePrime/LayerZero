@{
    ViewData["Title"] = "Benchmark — LayerZero.Tools.Web";
}

<div class="docs-wrapper">
    <aside class="docs-sidebar">
        @await Html.PartialAsync("_DocsSidebar")
    </aside>

    <div class="docs-content">
        <h1>Benchmark</h1>
        <p class="page-subtitle">Measure real-world load time and file size for every registered bundle from the browser.</p>

        <h2>What it does</h2>
        <p>
            The benchmark tool renders a clickable list of all registered bundle URLs. When the page loads,
            it fires an async <code>fetch()</code> with <code>cache: "no-store"</code> against each bundle, measures
            load time, reads the response body size, and displays the results inline — no external tooling required.
        </p>
        <p>
            Metrics displayed per bundle:
        </p>
        <ul>
            <li><strong>Content-Type</strong> — <code>text/css</code> or <code>application/javascript</code></li>
            <li><strong>Load time</strong> — milliseconds from request start to body received</li>
            <li><strong>Size</strong> — response body in KB</li>
        </ul>

        <h2>Enable Benchmark Mode</h2>
        <p>Set <code>EnableBenchmark = true</code> in <code>BundleCollectionConfig</code>. This registers an additional
        <code>/bundles/bulk.*</code> route that combines all assets into one file — useful as a baseline comparison.</p>
        <pre class="docs-code">builder.Services.<span class="mt">AddDynamicBundle</span>(<span class="kw">new</span> <span class="cl">BundleCollectionConfig</span>
{
    EnableBenchmark = <span class="nb">true</span>,
    <span class="cm">// ... other config</span>
});</pre>

        <div class="callout callout-warning">
            <strong>Development only.</strong>
            The benchmark mode is intended for local profiling. Avoid enabling it in production — it exposes
            all bundle routes in one list and registers the bulk bundle route which has no cache-key isolation.
        </div>

        <h2>Tag Helper</h2>
        <p>Add the tag helper anywhere in a view or layout:</p>
        <pre class="docs-code">&lt;<span class="cl">bundle-benchmark-loader</span> /&gt;</pre>

        <h3>Attributes</h3>
        <table class="config-table table table-bordered">
            <thead>
                <tr>
                    <th>Attribute</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="config-prop">filter</span></td>
                    <td><span class="config-type">string?</span></td>
                    <td>Case-insensitive substring filter. Only bundle names containing this value are listed. Omit to show all bundles.</td>
                </tr>
                <tr>
                    <td><span class="config-prop">type</span></td>
                    <td><span class="config-type">string?</span></td>
                    <td>Asset type filter: <code>"css"</code>, <code>"js"</code>, or omit to show both.</td>
                </tr>
            </tbody>
        </table>

        <h3>Examples</h3>
        <pre class="docs-code"><span class="cm">&lt;!-- Show all bundles --&gt;</span>
&lt;<span class="cl">bundle-benchmark-loader</span> /&gt;

<span class="cm">&lt;!-- Show only CSS bundles --&gt;</span>
&lt;<span class="cl">bundle-benchmark-loader</span> type="<span class="str">css</span>" /&gt;

<span class="cm">&lt;!-- Show only bundles containing "home" --&gt;</span>
&lt;<span class="cl">bundle-benchmark-loader</span> filter="<span class="str">home</span>" /&gt;

<span class="cm">&lt;!-- Combined: home JS only --&gt;</span>
&lt;<span class="cl">bundle-benchmark-loader</span> filter="<span class="str">home</span>" type="<span class="str">js</span>" /&gt;</pre>

        <h2>Live Demo</h2>
        <p>The <a asp-controller="Benchmark" asp-action="Index">Benchmark page</a> in this playground runs the tag helper
        against all bundles registered in this app.</p>

        <div class="callout callout-info">
            <strong>How load time is measured.</strong>
            Each bundle is fetched sequentially (not in parallel) so results are not affected by connection
            contention. The timer starts just before <code>fetch()</code> and stops after <code>arrayBuffer()</code>
            resolves — it includes DNS, TCP, TLS (if applicable), server processing, and full body transfer.
        </div>

        <h2>Bulk Bundle</h2>
        <p>
            When <code>EnableBenchmark = true</code>, a bulk route is registered that combines all CSS (or all JS) into one response:
        </p>
        <pre class="docs-code"><span class="cm">/* All CSS combined */</span>
GET /bundles/bulk.min.css

<span class="cm">/* All JS combined */</span>
GET /bundles/bulk.min.js</pre>
        <p>
            Use this to compare the cost of a single large bundle vs. the granular per-controller approach.
        </p>

        <div style="margin-top: 2.5rem; display:flex; gap: 1rem;">
            <a asp-controller="Docs" asp-action="ChangeLogs" class="btn btn-primary btn-sm">Changelog →</a>
            <a asp-controller="Docs" asp-action="Configuration" class="btn btn-outline-secondary btn-sm">← Configuration</a>
            <a asp-controller="Benchmark" asp-action="Index" class="btn btn-outline-primary btn-sm">Open Live Benchmark</a>
        </div>
    </div>
</div>
